[Unit]
Description=Keep smart-box converter probes outside the smart-box TUN
Wants=network-online.target
After=network-online.target
Before=smart-box-converter.service smart-box.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/smart-box-converter-route-bypass add
ExecStop=/usr/local/sbin/smart-box-converter-route-bypass remove
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
