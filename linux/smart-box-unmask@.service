[Unit]
Description=clear stale smart-box runtime masks for %i
Documentation=file:///usr/local/share/doc/smart-box/README.md

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/systemctl --runtime unmask -- smart-box@%i.service smart-box-watchdog@%i.service
TimeoutStartSec=15s
CapabilityBoundingSet=
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
