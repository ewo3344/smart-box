<Application x:Class="SingBoxSmart.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Ink" Color="#18201F" />
    <SolidColorBrush x:Key="Muted" Color="#64706E" />
    <SolidColorBrush x:Key="Canvas" Color="#F3F6F4" />
    <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent" Color="#087F73" />
    <SolidColorBrush x:Key="Warm" Color="#E36A42" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Aptos, Microsoft YaHei UI" />
      <Setter Property="Foreground" Value="{StaticResource Ink}" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="FontFamily" Value="Aptos, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Cascadia Mono, Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="BorderBrush" Value="#CBD4D1" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Application.Resources>
</Application>
