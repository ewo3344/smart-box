<Window x:Class="SingBoxSmart.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="smart-box" Width="980" Height="700" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Canvas}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="#DDE4E1" BorderThickness="0,0,0,1" Padding="26,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="smart-box" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="0.1.0   ·   基于 sing-box 1.14.0-beta.14" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="1" x:Name="StatusBadge" Background="#34413E" CornerRadius="4" Padding="12,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#87938F" Margin="0,0,8,0" />
            <TextBlock x:Name="StatusText" Text="未运行" Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" />
        <ColumnDefinition Width="18" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="#DDE4E1" BorderThickness="1" CornerRadius="6" Padding="20">
        <StackPanel>
          <TextBlock Text="订阅转换" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="树莓派总配置" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="118" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="92" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="协议" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" />
              <ComboBox x:Name="ProtocolBox" Height="40" SelectedIndex="0" VerticalContentAlignment="Center" SelectionChanged="ProtocolBox_SelectionChanged">
                <ComboBoxItem Content="HTTP" Tag="http" />
                <ComboBoxItem Content="HTTPS" Tag="https" />
              </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="域名或 IP" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" />
              <TextBox x:Name="HostBox" Height="40" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="4">
              <TextBlock Text="端口" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,5" />
              <TextBox x:Name="PortBox" Height="40" VerticalContentAlignment="Center" PreviewTextInput="PortBox_PreviewTextInput" />
            </StackPanel>
          </Grid>

          <TextBlock Text="私密订阅路径" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,5" />
          <Grid>
            <TextBox x:Name="PrivatePathBox" Height="40" VerticalContentAlignment="Center" TextChanged="PrivatePathBox_TextChanged" />
            <TextBlock x:Name="MaskedPath" Text="••••••••••••••••••••••••••••••" Background="White" Foreground="#65716E"
                       Padding="11,10" IsHitTestVisible="False" />
            <Button x:Name="RevealButton" Content="&#xE890;" FontFamily="Segoe Fluent Icons" Width="42" Height="38"
                    Padding="0" HorizontalAlignment="Right" ToolTip="显示或隐藏私密路径" Click="RevealButton_Click" />
          </Grid>

          <Button x:Name="PullButton" Margin="0,12,0,0" Background="{StaticResource Accent}" Foreground="White" BorderThickness="0" Click="PullButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="15" Margin="0,0,8,0" />
              <TextBlock Text="保存并拉取" Foreground="White" />
            </StackPanel>
          </Button>

          <Separator Margin="0,20,0,18" Background="#E5EAE8" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="代理核心" FontSize="15" FontWeight="SemiBold" />
              <TextBlock x:Name="ProfileStatusText" Text="尚未拉取配置" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button x:Name="StartStopButton" Grid.Column="1" Width="104" Click="StartStopButton_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StartStopIcon" Text="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="14" Margin="0,0,7,0" />
                <TextBlock x:Name="StartStopLabel" Text="启动" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Background="#EFF5F2" CornerRadius="4" Padding="12" Margin="0,16,0,0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="系统代理" FontWeight="SemiBold" FontSize="13" />
                <TextBlock Text="127.0.0.1:20808" Foreground="{StaticResource Muted}" FontFamily="Cascadia Mono" FontSize="11" Margin="0,3,0,0" />
              </StackPanel>
              <CheckBox x:Name="SystemProxyCheckBox" Grid.Column="1" VerticalAlignment="Center" Width="44" Height="24"
                        ToolTip="切换 Windows 系统代理" Click="SystemProxyCheckBox_Click" />
            </Grid>
          </Border>

          <TextBlock Text="每 30 分钟自动拉取一次" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,13,0,0" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Background="#111817" BorderBrush="#273330" BorderThickness="1" CornerRadius="6" Padding="0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="16,0">
            <TextBlock Text="运行日志" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="&#xE894;" FontFamily="Segoe Fluent Icons" ToolTip="清空日志" Width="34" Height="32" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearLogButton_Click" />
          </Grid>
          <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" Background="#111817" Foreground="#C7D4D0" BorderThickness="0"
                   Padding="16,10" FontFamily="Cascadia Mono" FontSize="12" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="22,0">
      <TextBlock x:Name="DataPathText" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
      <TextBlock Text="独立于官方 sing-box" Foreground="{StaticResource Warm}" FontSize="11" FontWeight="SemiBold"
                 HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Window>
